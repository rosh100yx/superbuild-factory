# Copy to .dev.vars for local dev. Never commit the real values.
# --- deploy rail ---
CF_API_TOKEN=
CF_ACCOUNT_ID=
# --- auth ---
FACTORY_TOKEN=local-dev-token
# --- model provider ---
# Which provider to call. "openrouter" (default) | "openai".
# Per-policy overrides win: FREE_PROVIDER / ZDR_PROVIDER.
MODEL_PROVIDER=openai
# Only the key for the provider you selected needs a value.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Model ids are PROVIDER-SPECIFIC. An OpenRouter id like "vendor/model" is not
# valid on OpenAI, and vice versa. Keep each provider's ids alongside its key.
# OpenAI examples:  gpt-4.1-mini | gpt-4o-mini | o4-mini
# OpenRouter:       deepseek/deepseek-v4-flash
FREE_MODEL=gpt-4.1-mini
ZDR_MODEL=gpt-4.1
